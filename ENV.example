# Sanity Configuration
# Copiez ce fichier vers .env.local et remplissez les valeurs

NEXT_PUBLIC_SANITY_PROJECT_ID=cle
NEXT_PUBLIC_SANITY_DATASET=production

# Google Analytics (GA4) - chargé via tarteaucitron.js après consentement
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Resend (formulaire de contact)
# Créez une clé sur https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Destinataire des messages (sans domaine vérifié = email du compte Resend)
CONTACT_TO_EMAIL=votre@email.com
# Expéditeur : sans domaine vérifié, gardez onboarding@resend.dev
# Avec domaine vérifié : Beeheidi <noreply@beeheidi.ch>
CONTACT_FROM_EMAIL=Beeheidi <onboarding@resend.dev>

# Google reCAPTCHA v2 "case à cocher" (formulaire de contact)
# Créez vos clés sur https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=votre_site_key
RECAPTCHA_SECRET_KEY=votre_secret_key
